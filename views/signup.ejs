<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>signup</title>
  <%- include("./partials/head") %>

       
</head>

<body>
    <main class="min-h-screen w-screen bg-neutral-50 flex items-center justify-center   ">

        <form action="/signup" method="POST"
         class="min-w-md bg-neutral-300/30 px-6 py-8 rounded-xl mx-auto flex flex-col items-start gap-4">
         <h2 class="text-xl font-bold text-neutral-900 uppercase mb-6  text-center">Create an account</h2>

            <label class="text-base font-semibold text-black flex items-center ">Full Name: </label>
            <input class=" w-full bg-neutral-50 border-none rounded-md px-4 py-2 placeholder:text-base placeholder:text-neutral-400 placeholder:font-medium"  
            type="text" 
            name="fullName" 
            placeholder="Enter your Name" 
            required
            />
                
            
            <label class="text-base font-semibold text-black flex items-center " >Email: </label>
            <input class="w-full bg-neutral-50 border-none rounded-md px-4 py-2 placeholder:text-base placeholder:text-neutral-400 placeholder:font-medium"  
            type="email" 
            name="email" 
            placeholder="eg:example123@gmail.com" 
            required />
                

            <label class="text-base font-semibold text-black flex items-center ">Password: </label>
            <input class=" w-full bg-neutral-50 border-none rounded-md px-4 py-2 placeholder:text-base placeholder:text-neutral-400 placeholder:font-medium"  
            type="password" 
            name="password" 
            placeholder="8+Characters" 
            required />
                
            
            <button  class=" bg-linear-to-b from-blue-500 to-blue-700 px-4 py-2 w-full rounded-xl text-shadow-xs text-white rounded-lg active:scale-98 hover:bg-blue-700 cursor-pointer" type="submit">Signup</button>
        </form>
    </main>
   
</body>

</html>
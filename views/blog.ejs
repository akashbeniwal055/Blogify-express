<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>home page</title>

    <%- include("./partials/head") %>
    
</head>
<body>
    
<%- include("./partials/navbar") %> 
       

 <main class="max-w-5xl  mt-4  min-h-screen mx-auto w-full flex items-start gap-4 ">
   
<% if (locals.blog) { %>
  <div class="w-full min-h-screen flex flex-col  items-start gap-8 pb-12" >
    <div class="w-full h-1/4 rounded-2xl p-1 border border-neutral-400/20 overflow-hidden relative "> 
        <img src="<%= blog.coverImageUrl  %> " class="w-full h-full rounded-[15px] object-cover " />  
    </div>
    <div class="w-full h-20 text-3xl font-bold text-black  ">
        <h2><%= blog.title %> </h2>
    </div>
    <div class="w-full  text-base font-medium text-neutral-600">
        <p> <%= blog.description %> </p>
    </div>
  </div>

 
<% } %>
    
    
</main>
    
    

</body>
</html>
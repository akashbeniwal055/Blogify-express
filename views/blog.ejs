<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>home page</title>

  <%- include("./partials/head") %>

</head>

<body>

  <%- include("./partials/navbar") %>


    <main class="max-w-5xl py-4 mt-4  min-h-screen mx-auto w-full flex flex-col items-start gap-4 overflow-hidden">

      <% if (locals.blog) { %>

        <div class="w-full min-h-screen  gap-8 pb-12">
          <div class="w-full h-1/4 rounded-2xl p-1 border border-neutral-400/20 overflow-hidden relative ">
            <img src="<%= blog.coverImageUrl  %> " class="w-full h-full rounded-[15px] object-cover " />
          </div>
          <div class="w-full h-20 text-3xl font-bold text-black  ">
            <h2>
              <%= blog.title %>
            </h2>
          </div>
          <div class="w-full  text-base font-medium text-neutral-600">
            <pre> <%= blog.description %> </pre>
          </div>
        </div>


        <div class=" w-full h-20 flex items-center gap-2 ">
          <div class="size-10  rounded-full border border-neutral-400/20 overflow-hidden relative ">
            <img src="<%= blog.createdBy.profileImageUrl  %> " class="w-full h-full object-cover scale-110 " />
          </div>
          <div class="w-full  text-sm font-medium text-black  ">
            <h4>
              <%= blog.createdBy.fullName %>
            </h4>
          </div>

        </div>

        <form action="/comment/<%= blog._id %> " method="post"
          class="w-full  bg-neutral-300/30 px-6 py-8 rounded-xl mx-auto flex flex-col items-start gap-4">
          <h2 class="text-xl font-bold text-neutral-900 uppercase mb-6  text-center">Comments</h2>


          <input
            class="w-full bg-neutral-50 border-none rounded-md px-4 py-2 placeholder:text-base placeholder:text-neutral-400 placeholder:font-medium"
            type="text" name="content" placeholder="Type your comment" required />



          <button
            class=" bg-linear-to-b from-blue-500 to-blue-700 px-4 py-2 w-full rounded-xl text-shadow-xs text-white rounded-lg active:scale-98 hover:bg-blue-700 cursor-pointer"
            type="submit">Post</button>
        </form>


       
        <% } %>


  <div class="w-full mt-8 flex flex-col  items-start   gap-4">

    <% comments.forEach(comment=> { %>
      <div class=" w-full flex items-center gap-4 ">
        <div class="size-10  rounded-full border border-neutral-400/20 overflow-hidden relative ">
          <img src="<%= comment.createdBy.profileImageUrl  %> " class="w-full h-full object-cover scale-110 " />
        </div>
        <div class=" text-base font-medium text-black  ">
          <h4>
            <%= comment.createdBy.fullName %>
          </h4>
        </div>

        <div class="  text-base font-medium text-neutral-600">
          <h4>
            <%= comment.content %>
          </h4>
        </div>

      </div>


      <% }) %>

  </div>

        


    </main>



</body>

</html>
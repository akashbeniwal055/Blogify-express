<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>home page</title>

    <%- include("./partials/head") %>
    
</head>
<body>
    
        <%- include("./partials/navbar") %> 
       

 <main class="max-w-7xl mt-4  min-h-screen mx-auto w-full">
   
    <h1 class=" text-center text-3xl font-bold text-black mx-auto my-4" >Blogify homepage</h1>
    <% if (locals.allBlogs) { %>


<div class="w-full h-full grid grid-cols-4 gap-4   ">
        <% allBlogs.forEach(blog => { %>
 
            <div class="size-70 rounded-xl bg-neutral-100 border border-neutral-400/20 flex flex-col items-center  px-1 py-1 ">
                <div class="w-full h-40   bg-neutral-400 rounded-[11px] overflow-hidden ">
                    <img class="w-full h-full object-cover" 
                    src="<%= blog.coverImageUrl %>" alt="default" />
               
                   
                </div>
                
        
                <div class=" w-full h-20  p-2 rounded-xl ">
                    <h3 class="text-base font-semibold text-black " >
                        <%= blog.title %> 
                    </h3>
                </div>
    
                <div class=" w-full h-20  p-2 rounded-xl ">
                    
                    <h3 class="text-base font-light text-neutral-400 " >
                        <%= blog.description.split(' ').slice(0, 10).join(' ') %>
                        <% if (blog.description.split(' ').length > 10) { %>...<% } %>
                    </h3>
                </div>

                <div class="w-full h-20 flex items-center justify-center gap-2 mx-auto ">

                    <a href="/blog/delete/<%= blog._id %>" class="flex items-center gap-2 bg-red-500 border border-red-500 px-4 py-2 text-base font-medium  text-shadow-xs text-white rounded-xl active:scale-98 hover:bg-red-600" >
                        <%- include("./partials/delete") %>
                        <span >Delete</span>
                    </a>
                
                
                    <a href="/blog/<%= blog._id %> " class="bg-blue-500 px-4 py-2 text-base font-medium text-shadow-xs text-black rounded-xl active:scale-98 hover:bg-blue-600" >View more</a>
                
                </div>

            </div>
         
        <% }) %>
        
    <% } %>
</div>
    
 </main>
    
    

</body>
</html>